# ============================================================
# App Progetto Amazing — configurazione (copiare in .env.local)
# ============================================================

# --- NextAuth (solo area admin) ---
# Genera con: openssl rand -base64 32
AUTH_SECRET=genera-un-secret-casuale
NEXTAUTH_URL=http://localhost:3000

# --- Microsoft Entra ID (App Registration) — login admin ---
# Redirect URI: http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=<Application (client) ID>
AUTH_MICROSOFT_ENTRA_ID_SECRET=<Client Secret value>
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=9758581d-e1a8-4a08-90c9-d2f5e3b16ea5

# --- Graph API (permessi APPLICATION, client credentials) ---
# Stessa App Registration. API permissions richiesti:
#   Sites.ReadWrite.All (Application)  — Liste SharePoint
#   Mail.Send (Application)            — invio ricevute via email (anche a destinatari esterni)
GRAPH_TENANT_ID=9758581d-e1a8-4a08-90c9-d2f5e3b16ea5
GRAPH_CLIENT_ID=<Application (client) ID>
GRAPH_CLIENT_SECRET=<Client Secret value>

# --- SharePoint ---
SHAREPOINT_SITE_URL=https://coopmirafiorionlus.sharepoint.com/sites/<sito>
# Ottieni il site-id con:
#   GET https://graph.microsoft.com/v1.0/sites/coopmirafiorionlus.sharepoint.com:/sites/<sito>
SHAREPOINT_SITE_ID=<site-id da Graph>

# GUID delle liste (crea le liste con provision-amazing.mjs, poi copia i GUID)
SP_LIST_BENI=<guid lista Beni>
SP_LIST_PRENOTAZIONI=<guid lista Prenotazioni>
# Lista amministratori (colonna Title = email). Se assente, valgono solo gli ADMIN_EMAILS.
SP_LIST_ADMIN=<guid lista AmazingAdmin>

# --- Email ---
# Casella mittente CON licenza Exchange (Graph invia "come" questa casella)
MAIL_SENDER_EMAIL=cooperativamirafiori@cooperativamirafiori.com
# Copia di cortesia interna di ogni ricevuta (opzionale)
MAIL_BCC=cooperativamirafiori@cooperativamirafiori.com

# --- Admin (chi può accedere all'area riservata) ---
# Email autorizzate, separate da virgola
ADMIN_EMAILS=dennis.maseri@cooperativamirafiori.com

# --- Dati cooperativa / pagamento ---
BONIFICO_IBAN=IT31A0200801125000101772702
BONIFICO_BANCA=Banca Unicredit
RAPPRESENTANTE_LEGALE=LUCA CORDARO

# --- URL pubblico dell'app (per redirect/callback di PayPal e Satispay) ---
# In locale: http://localhost:3000 — in Production: https://amazing-mirafiori.vercel.app
APP_BASE_URL=http://localhost:3000

# --- Satispay Business API ---
# SATISPAY_ENV: "production" (default) o "sandbox".
# ATTENZIONE: keyId e chiave privata erano in chiaro nella vecchia app (Code_v4.gs):
# vanno RUOTATI su Satispay Business e messi qui SOLO come variabili d'ambiente.
SATISPAY_ENV=production
SATISPAY_KEY_ID=<keyId Satispay attivato>
# Chiave privata RSA in PEM. Su una sola riga usare \n al posto degli a-capo.
SATISPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# --- PayPal (Orders API v2) ---
# PAYPAL_MODE: "live" (default) o "sandbox"
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=<PayPal client id>
PAYPAL_CLIENT_SECRET=<PayPal client secret>
